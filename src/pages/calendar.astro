---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Calendar — MOBY Community Garden" description="Upcoming events at MOBY Community Garden." />
	</head>
	<body>
		<Header />
		<main>
			<section>
				<h2>Calendar</h2>
				<p>Check out upcoming events and garden dates below.</p>
				<div class="calendar-embed">
					<iframe
						src="https://calendar.google.com/calendar/embed?src=c_37927ec81b931d5ed3506b49e7e40cc45e5bea048df2fec865fe3e1cc01f0663%40group.calendar.google.com&ctz=America%2FVancouver"
						style="border: 0"
						width="800"
						height="600"
						frameborder="0"
						scrolling="no"
					></iframe>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	section {
		margin-top: 2.5em;
	}

	h2 {
		margin-bottom: 0.75em;
	}

	p {
		margin-bottom: 0.6em;
		font-size: 0.95em;
	}

	.calendar-embed {
		margin-top: 1.5em;
		max-width: 800px;
		overflow-x: auto;
	}

	.calendar-embed iframe {
		max-width: 100%;
	}
</style>
