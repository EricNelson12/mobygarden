---
// Footer.astro
---

<footer class="footer">
  <div class="footer-inner">
    <address>1737 E 11th Ave, Vancouver</address>
    <a href="mailto:info@mobygarden.ca">info@mobygarden.ca</a>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid #e5e5e5;
    padding: 1.5rem 1rem;
    background: #fafafa;
  }

  .footer-inner {
    max-width: 900px;
    margin: 0 auto;

    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  address {
    font-style: normal;
    font-size: 0.8rem;
    color: #666;
  }

  a {
    font-size: 0.8rem;
    color: #333;
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  /* mobile stack */
  @media (max-width: 600px) {
    .footer-inner {
      flex-direction: column;
      text-align: center;
    }
  }
</style>